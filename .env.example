# Public browser configuration. Never put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
APP_ORIGIN=http://localhost:3000

# Migration administrator: use a disposable database ending in _test during development.
# The application web process does not use this connection.
# secretlint-disable-next-line @secretlint/secretlint-rule-database-connection-string -- placeholder credentials (replace_me), not a real secret
DATABASE_URL=postgresql://migration_user:replace_me@localhost:5432/moflo_test

# Dedicated worker login, member of moflo_worker only; no direct table grants.
# secretlint-disable-next-line @secretlint/secretlint-rule-database-connection-string -- placeholder credentials (replace_me), not a real secret
WORKER_DATABASE_URL=postgresql://worker_user:replace_me@localhost:5432/moflo_test
WORKER_ID=

# Optional worker-to-renderer and renderer-to-egress private service credentials.
RENDERER_URL=
RENDERER_TOKEN=
EGRESS_URL=
EGRESS_TOKEN=
# Renderer operator input; rendering arbitrary URLs fails closed without real host evidence.
RENDERER_BOUNDARY_REPORT=
CHROMIUM_PATH=/usr/bin/chromium
RENDERER_BIND=127.0.0.1
RENDERER_PORT=3002
EGRESS_BIND=127.0.0.1
EGRESS_PORT=3128

# Crawl limits (all optional; the values shown are the defaults). `none` removes a limit where noted. Web app and worker
# must use the same CRAWL_MAX_* values. Removing time or byte limits can make a crawl run for a very long time and
# hit free-tier quotas. See docs/crawler.md.
# CRAWL_MAX_PAGES=25   # none: No ceiling on the page limit a member may choose
# CRAWL_DEFAULT_PAGES=10   # none: Not removable (a number is needed)
# CRAWL_MAX_DEPTH=3   # none: No ceiling on link depth
# CRAWL_DEFAULT_DEPTH=2   # none: Not removable
# CRAWL_MAX_DISCOVERED=200   # none: No cap on links remembered per crawl
# CRAWL_FETCH_TIMEOUT_MS=15000   # none: A page request may take as long as the crawl time budget allows
# CRAWL_RENDER_TIMEOUT_MS=25000   # none: No time limit on a browser render (the browser service itself stops at 25 s)
# CRAWL_TIME_BUDGET_MS=300000   # none: The crawl has no time budget
# CRAWL_MAX_HTML_BYTES=2097152   # none: No size limit on one page
# CRAWL_MAX_DESIGN_BYTES=15728640   # none: No limit on browser design resources (the browser service itself stops at 15 MiB)
# CRAWL_HOST_GAP_MS=500   # none: Not removable; 0 means no wait between requests to one site
# CRAWL_HTTP_CONCURRENCY=3   # none: Not removable (minimum 1)
# CRAWL_RENDER_CONCURRENCY=1   # none: Not removable (minimum 1)
# WORKER_JOB_TIMEOUT_MS=600000   # none: A job (crawl and extraction) is never stopped for taking too long

# Optional crawl agent, disabled by default. When CRAWL_AGENT_ENABLED is exactly "true", a language model
# (any OpenAI-compatible chat completions endpoint) orders or narrows the next links the crawl visits.
# It never writes facts. The prompt is a file name inside prompts/.
# CRAWL_AGENT_ENABLED=true
# CRAWL_AGENT_API_KEY=
# CRAWL_AGENT_MODEL=
# CRAWL_AGENT_BASE_URL=https://openrouter.ai/api/v1
# CRAWL_AGENT_PROMPT=

# Optional local operations read-only connection and disposable DB test target.
# secretlint-disable-next-line @secretlint/secretlint-rule-database-connection-string -- placeholder credentials (replace_me), not a real secret
MOFLO_OPS_DATABASE_URL=postgresql://ops_user:replace_me@localhost:5432/moflo_test
# secretlint-disable-next-line @secretlint/secretlint-rule-database-connection-string -- placeholder credentials (replace_me), not a real secret
TEST_DATABASE_URL=postgresql://migration_user:replace_me@localhost:5432/moflo_test
TEST_DATABASE_NAME=moflo_test

# Optional runtime probe inputs; a probe is not production host qualification.
MOFLO_OWNER_SELECTED_HOST_ID=
MOFLO_RUNTIME_SAMPLE_URL=
OUTBOUND_PROXY_URL=

# Test-only browser inputs; populate privately with disposable accounts, never production users.
MOFLO_E2E_OWNER_EMAIL=
MOFLO_E2E_OWNER_PASSWORD=
MOFLO_E2E_SECOND_EMAIL=
MOFLO_E2E_SECOND_PASSWORD=
MOFLO_E2E_FIXTURE_URL=
MOFLO_E2E_PORT=3173
MOFLO_E2E_TIMEOUT_MS=180000
MOFLO_FIXTURE_PORT=4173
MOFLO_TEST_ALLOWED_ORIGINS=127.0.0.1
