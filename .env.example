# Public browser configuration. Never put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
APP_ORIGIN=http://localhost:3000

# Migration administrator: use a disposable database ending in _test during development.
# The application web process does not use this connection.
DATABASE_URL=postgresql://migration_user:replace_me@localhost:5432/moflo_test

# Dedicated worker login, member of moflo_worker only; no direct table grants.
WORKER_DATABASE_URL=postgresql://worker_user:replace_me@localhost:5432/moflo_test
WORKER_ID=

# Optional worker extraction. These two names currently serve different entry points;
# use the same owner-selected model identifier in both when qualifying and running it.
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=
# scripts/qualify-model.ts and scripts/probe-runtime.mjs currently read OPENAI_MODEL.
OPENAI_MODEL=

# Optional worker-to-renderer and renderer-to-egress private service credentials.
RENDERER_URL=
RENDERER_TOKEN=
EGRESS_URL=
EGRESS_TOKEN=
# Renderer operator input; rendering arbitrary URLs fails closed without real host evidence.
RENDERER_BOUNDARY_REPORT=
CHROMIUM_PATH=/usr/bin/chromium
RENDERER_BIND=127.0.0.1
RENDERER_PORT=3002
EGRESS_BIND=127.0.0.1
EGRESS_PORT=3128

# Optional local operations read-only connection and disposable DB test target.
MOFLO_OPS_DATABASE_URL=postgresql://ops_user:replace_me@localhost:5432/moflo_test
TEST_DATABASE_URL=postgresql://migration_user:replace_me@localhost:5432/moflo_test
TEST_DATABASE_NAME=moflo_test

# Optional runtime probe inputs; a probe is not production host qualification.
MOFLO_OWNER_SELECTED_HOST_ID=
MOFLO_RUNTIME_SAMPLE_URL=
OUTBOUND_PROXY_URL=

# Test-only browser inputs; populate privately with disposable accounts, never production users.
MOFLO_E2E_OWNER_EMAIL=
MOFLO_E2E_OWNER_PASSWORD=
MOFLO_E2E_SECOND_EMAIL=
MOFLO_E2E_SECOND_PASSWORD=
MOFLO_E2E_FIXTURE_URL=
MOFLO_E2E_PORT=3173
MOFLO_E2E_TIMEOUT_MS=180000
MOFLO_FIXTURE_PORT=4173
MOFLO_TEST_ALLOWED_ORIGINS=127.0.0.1
